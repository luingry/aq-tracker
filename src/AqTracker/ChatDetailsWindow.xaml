<Window x:Class="AqTracker.ChatDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AqTracker" Title="{DynamicResource Loc.DetailsByChat}" Width="308" Height="580" MinWidth="260" MinHeight="320" WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Background="Transparent" AllowsTransparency="True">
  <local:RoundedClipBorder Background="{DynamicResource DetailedSurface}" CornerRadius="12">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="Header" MouseLeftButtonDown="HeaderMouseLeftButtonDown"><TextBlock Text="{DynamicResource Loc.DetailsByChat}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/><Button HorizontalAlignment="Right" Click="CloseWindow" ToolTip="{DynamicResource Loc.CloseWindow}" AutomationProperties.Name="{DynamicResource Loc.CloseWindow}" Padding="4"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M18,6L6,18M6,6L18,18" Stroke="{DynamicResource SoftInk}" StrokeThickness="1.7"/></Canvas></Viewbox></Button></Grid>
      <Grid Grid.Row="1" Margin="0,9,0,0"><TextBox Text="{Binding ChatSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Loc.SearchChats}" AutomationProperties.Name="{DynamicResource Loc.SearchChats}" Padding="9,6,28,6" FontSize="10"/><TextBlock Text="{DynamicResource Loc.SearchChats}" Foreground="{DynamicResource SoftInk}" FontSize="10" Margin="9,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ChatSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ChatSearch}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed"/></Style></TextBlock.Style></TextBlock><Viewbox Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"><Viewbox.Style><Style TargetType="Viewbox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ChatSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Viewbox.Style><Canvas Width="24" Height="24"><Ellipse Canvas.Left="3" Canvas.Top="3" Width="16" Height="16" Stroke="{DynamicResource SoftInk}" StrokeThickness="1.7"/><Path Data="M16.65,16.65L21,21" Stroke="{DynamicResource SoftInk}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox><Button Click="ClearChatSearch" ToolTip="{DynamicResource Loc.ClearSearch}" AutomationProperties.Name="{DynamicResource Loc.ClearSearch}" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3" Margin="0,0,3,0"><Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ChatSearch}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ChatSearch}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M18,6L6,18M6,6L18,18" Stroke="{DynamicResource SoftInk}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button></Grid>
      <Grid Grid.Row="2" Margin="0,10,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasVisibleChatProjects, Converter={StaticResource BooleanToVisibility}}"><ItemsControl ItemsSource="{Binding ChatProjects}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,6" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
        <Button Click="ToggleProject" Background="Transparent" Padding="8,6"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="ProjectHeaderSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ProjectHeaderName" Text="{Binding Project}" FontSize="9.2" FontWeight="SemiBold" Foreground="{DynamicResource SoftInk}" Opacity=".62" TextTrimming="CharacterEllipsis"/><Border x:Name="ProjectHeaderDivider" Grid.Column="1" Height=".5" Background="{DynamicResource SoftInk}" Opacity=".62" VerticalAlignment="Center" Margin="8,0"/><Path x:Name="ProjectHeaderChevron" Grid.Column="2" Width="10" Height="5" Stretch="Fill" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource SoftInk}" Opacity=".62" StrokeThickness="1.6" VerticalAlignment="Center"><Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Data" Value="M0,5 L5,0 L10,5"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ProjectHeaderName" Property="Foreground" Value="{DynamicResource Ink}"/><Setter TargetName="ProjectHeaderName" Property="Opacity" Value="1"/><Setter TargetName="ProjectHeaderDivider" Property="Background" Value="{DynamicResource Ink}"/><Setter TargetName="ProjectHeaderDivider" Property="Opacity" Value="1"/><Setter TargetName="ProjectHeaderChevron" Property="Stroke" Value="{DynamicResource Ink}"/><Setter TargetName="ProjectHeaderChevron" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ProjectHeaderSurface" Property="Opacity" Value=".72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
        <ItemsControl ItemsSource="{Binding Chats}" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,6"><ItemsControl.ItemTemplate><DataTemplate><local:RoundedClipBorder Background="{DynamicResource InputSurface}" CornerRadius="8" Padding="8" Margin="0,1"><StackPanel><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/><Grid Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.CachedRead}" FontSize="9" Foreground="{DynamicResource SoftInk}"/><TextBlock Grid.Column="1" Text="{Binding CachedReadTokens}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="9" Foreground="{DynamicResource Ink}"/><ProgressBar Grid.ColumnSpan="2" Value="{Binding CachedReadFraction}" Maximum="1" Height="3" Margin="0,13,0,4" Background="{DynamicResource Sage}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top"/></Grid>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.Input}" FontSize="9" Foreground="{DynamicResource SoftInk}"/><TextBlock Grid.Column="1" Text="{Binding InputTokens}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="9" Foreground="{DynamicResource Ink}"/><ProgressBar Grid.ColumnSpan="2" Value="{Binding InputFraction}" Maximum="1" Height="3" Margin="0,13,0,4" Background="{DynamicResource Sage}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top"/></Grid>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.Output}" FontSize="9" Foreground="{DynamicResource SoftInk}"/><TextBlock Grid.Column="1" Text="{Binding OutputTokens}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="9" Foreground="{DynamicResource Ink}"/><ProgressBar Grid.ColumnSpan="2" Value="{Binding OutputFraction}" Maximum="1" Height="3" Margin="0,13,0,4" Background="{DynamicResource Sage}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top"/></Grid>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.Reasoning}" FontSize="9" Foreground="{DynamicResource SoftInk}"/><TextBlock Grid.Column="1" Text="{Binding ReasoningTokens}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="9" Foreground="{DynamicResource Ink}"/><ProgressBar Grid.ColumnSpan="2" Value="{Binding ReasoningFraction}" Maximum="1" Height="3" Margin="0,13,0,4" Background="{DynamicResource Sage}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top"/></Grid>
          <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.Total}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/><TextBlock Grid.Column="1" Text="{Binding TotalTokens}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/></Grid>
        </Grid></StackPanel></local:RoundedClipBorder></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="{DynamicResource Loc.NoChats}" Foreground="{DynamicResource SoftInk}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasVisibleChatProjects}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    </Grid>
  </local:RoundedClipBorder>
</Window>
