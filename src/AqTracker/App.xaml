<Application x:Class="AqTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AqTracker"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Porcelain" Color="#F7F7F4" />
    <SolidColorBrush x:Key="Ink" Color="#202523" />
    <SolidColorBrush x:Key="SoftInk" Color="#59635F" />
    <SolidColorBrush x:Key="Sage" Color="#D5E9E2" />
    <SolidColorBrush x:Key="Apricot" Color="#F7D6B9" />
    <SolidColorBrush x:Key="Lavender" Color="#DFD7F1" />
    <SolidColorBrush x:Key="Accent" Color="#0D8F6F" />
    <SolidColorBrush x:Key="AgentMetadataAccent" Color="#367E6E" />
    <Color x:Key="AccentGlow">#2BA98A</Color>
    <SolidColorBrush x:Key="RiskWarning" Color="#B66A00" />
    <SolidColorBrush x:Key="GaugeTrack" Color="#CCD5D1" />
    <SolidColorBrush x:Key="DetailedSurface" Color="#FFF7F7F4" />
    <SolidColorBrush x:Key="GlassSurface" Color="#FFF7F7F4" />
    <SolidColorBrush x:Key="GlassLavender" Color="#FFEAE8EF" />
    <SolidColorBrush x:Key="SettingsSurface" Color="#FFF2F2EE" />
    <SolidColorBrush x:Key="InputSurface" Color="#FFE7EBE8" />
    <SolidColorBrush x:Key="HoverSurface" Color="#FFDCE7E2" />
    <SolidColorBrush x:Key="CardSurface" Color="#FFFBFBF9" />
    <SolidColorBrush x:Key="CardBorder" Color="#FFE0E4E1" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ClaudeAccent" Color="#D97757" />
    <SolidColorBrush x:Key="OnClaudeAccent" Color="#FF151A18" />
    <SolidColorBrush x:Key="Danger" Color="#FFB42318" />
    <SolidColorBrush x:Key="DangerSoft" Color="#1AB42318" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <local:CompactVisibilityConverter x:Key="CompactVisibility" />
    <local:CompactGaugeDiameterConverter x:Key="CompactGaugeDiameter" />
    <local:CompactQuotaGaugeSizeConverter x:Key="CompactQuotaGaugeSize" />

    <Style x:Key="TokenUsageToolTip" TargetType="{x:Type ToolTip}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToolTip}">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate DataType="{x:Type local:TokenUsageTooltip}">
      <Border Background="{DynamicResource DetailedSurface}" CornerRadius="8" Padding="12,10" MinWidth="210" MaxWidth="300">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding EstimateNote}" Margin="0,1,0,6" FontFamily="./assets/fonts/#Atkinson Hyperlegible Next" FontSize="8" Foreground="{DynamicResource SoftInk}" />
            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontFamily="./assets/fonts/#Atkinson Hyperlegible Next" FontSize="9" Foreground="{DynamicResource SoftInk}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding Cost}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="8.5" Foreground="{DynamicResource SoftInk}" />
                      <TextBlock Text=" · " FontFamily="./assets/fonts/#Source Sans 3" FontSize="8.5" Foreground="{DynamicResource SoftInk}" />
                      <TextBlock Text="{Binding Tokens}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                    </StackPanel>
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Fraction}" Maximum="1" Height="3" Margin="0,3,0,0" Background="{DynamicResource Sage}" Foreground="{DynamicResource Accent}" VerticalAlignment="Bottom" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Border Grid.Row="2" Height="1" Background="{DynamicResource InputSurface}" VerticalAlignment="Center" />
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Total.Label}" FontFamily="./assets/fonts/#Atkinson Hyperlegible Next" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="{Binding Total.Cost}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SoftInk}" />
              <TextBlock Text=" · " FontFamily="./assets/fonts/#Source Sans 3" FontSize="8.5" Foreground="{DynamicResource SoftInk}" />
              <TextBlock Text="{Binding Total.Tokens}" FontFamily="./assets/fonts/#Source Sans 3" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Ink}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SoftInk}" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".72" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputSurface}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" Foreground="{TemplateBinding Foreground}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource InputSurface}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" Cursor="{TemplateBinding Cursor}" Padding="{TemplateBinding Padding}" Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Margin="0,0,4,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        <Path Grid.Column="1" Data="M7,9L12,14L17,9" Stroke="{DynamicResource SoftInk}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Sage}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=Toggle}">
                <Border Background="{DynamicResource Porcelain}" CornerRadius="9" Padding="4" MinWidth="{Binding ActualWidth, ElementName=Toggle}" Margin="0,4,0,0">
                  <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Sage}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <BulletDecorator Background="Transparent">
              <BulletDecorator.Bullet>
                <Border x:Name="Mark" Width="16" Height="16" CornerRadius="5" Background="{DynamicResource InputSurface}">
                  <Path x:Name="Tick" Data="M4,8L7,11L13,4" Stroke="{DynamicResource Ink}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                </Border>
              </BulletDecorator.Bullet>
              <ContentPresenter Margin="13,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </BulletDecorator>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Background" Value="{DynamicResource Sage}" /><Setter TargetName="Tick" Property="Visibility" Value="Visible" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Mark" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="./assets/fonts/#Source Sans 3" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SoftInk}" />
    </Style>

    <Style x:Key="ConsumptionDetailsExpander" TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton x:Name="ConsumptionHeader" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" Cursor="Hand"
                            AutomationProperties.Name="{TemplateBinding Header}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderSurface" Background="{DynamicResource InputSurface}" CornerRadius="8" Padding="10,8">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="11" TextElement.FontWeight="SemiBold" />
                        <Path x:Name="Chevron" Grid.Column="1" Data="M2,2L7,7L12,2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="10,0,0,0" RenderTransformOrigin=".5,.5">
                          <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                        </Path>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ConsumptionContent" Visibility="Collapsed" Margin="0,10,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ConsumptionContent" Property="Visibility" Value="Visible" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Settings layout: one card per scope, a titled header, label/control rows. -->
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardSurface}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,11,12,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsRowLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SettingsHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource SoftInk}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SettingsDivider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource CardBorder}" />
      <Setter Property="Margin" Value="0,10" />
    </Style>

    <!-- Action buttons share one template; the role styles below differ only in emphasis.
         Primary = the one confirming action per area, Secondary = neutral alternatives,
         Ghost = low-emphasis/tertiary links, Danger = destructive actions, Field = a value picker. -->
    <ControlTemplate x:Key="ActionButtonTemplate" TargetType="Button">
      <Grid x:Name="Root" SnapsToDevicePixels="True">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
        <Border x:Name="Tint" Background="{TemplateBinding Foreground}" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value=".09" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tint" Property="Opacity" Value=".12" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value=".18" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ActionButtonBase" TargetType="Button">
      <Setter Property="Template" Value="{StaticResource ActionButtonTemplate}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
      <Setter Property="Background" Value="{DynamicResource InputSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
      <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>

    <Style x:Key="FieldButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
      <Setter Property="Background" Value="{DynamicResource InputSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="ThemeSwitch" TargetType="CheckBox">
      <Setter Property="Width" Value="38" /><Setter Property="Height" Value="22" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Background="{DynamicResource InputSurface}" CornerRadius="11" Padding="3">
              <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource SoftInk}" HorizontalAlignment="Left" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Sage}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Accent}" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
              <Grid x:Name="PART_Track">
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" ClipToBounds="True">
                </Border>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7" />
      <Setter Property="MinWidth" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Margin="1,3">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Background="{DynamicResource SoftInk}" Opacity=".34">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4" /></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="7" /><Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="0" /></Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
