<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\brand\aq-tracker.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\AqTracker.Core\AqTracker.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- UpdateController's GithubUpdateClient dependency (AqTracker.Core) exposes an HttpClient
         parameter on its public constructor; net48 project references don't flow framework
         Reference items transitively, so this project needs its own reference to resolve it. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup><Resource Include="..\..\assets\fonts\SourceSans3.ttf" Link="assets\fonts\SourceSans3.ttf" /><Resource Include="..\..\assets\fonts\AtkinsonHyperlegibleNext.ttf" Link="assets\fonts\AtkinsonHyperlegibleNext.ttf" /></ItemGroup>
</Project>
